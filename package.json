{
  "name": "fighter-simulation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 3000 --bind 0.0.0.0",
    "build": "python3 -m py_compile backend/*.py && npm --prefix frontend run build",
    "lint": "python3 -m py_compile backend/*.py",
    "build:backend": "python3 -m py_compile backend/*.py",
    "build:frontend": "npm --prefix frontend run build",
    "typecheck:frontend": "npm --prefix frontend run typecheck"
  }
}
